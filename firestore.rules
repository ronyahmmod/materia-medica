rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function userEmailLower() {
      return request.auth.token.email.lower();
    }

    // Super Admin: Strictly verified Google account matching platform owner
    function isPrimaryAdmin() {
      return isSignedIn()
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && userEmailLower() == 'rony.jib@gmail.com';
    }

    function clinicDoc(clinicId) {
      return get(/databases/$(database)/documents/clinics/$(clinicId));
    }

    function isClinicMember(clinicId) {
      return isSignedIn()
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/clinics/$(clinicId))
        && request.auth.uid in clinicDoc(clinicId).data.authorizedUids
        && (
          userEmailLower() in clinicDoc(clinicId).data.accessEmails
          || request.auth.token.email in clinicDoc(clinicId).data.accessEmails
          || clinicDoc(clinicId).data.ownerEmail.lower() == userEmailLower()
        );
    }

    function isClinicActiveMember(clinicId) {
      return isClinicMember(clinicId)
        && clinicDoc(clinicId).data.subscriptionStatus != 'suspended';
    }

    function isClinicWritable(clinicId) {
      return isPrimaryAdmin() || isClinicActiveMember(clinicId);
    }

    // 1. SaaS Platform Hosting Configuration (Super Admin writes; signed-in users may read)
    match /platform_config/{configId} {
      allow list: if isPrimaryAdmin();
      allow get: if isSignedIn();
      allow create, update, delete: if isPrimaryAdmin();
    }

    // 2. Non-PII Public White-Label Branding Storefront (Keyed by URL Slug)
    match /clinic_public/{slug} {
      allow get: if true;
      allow list, create, update, delete: if isPrimaryAdmin();
    }

    // 3. Multi-Tenant Clinics Master Collection & Isolated Subcollections
    match /clinics/{clinicId} {
      allow list: if isPrimaryAdmin()
        || (isSignedIn() && request.auth.uid in resource.data.authorizedUids);

      allow get: if isPrimaryAdmin() || isClinicMember(clinicId);
      allow create, delete: if isPrimaryAdmin();

      // Super Admin can edit anything; active clinic members can update presence heartbeat fields without altering plan/billing/ACL
      allow update: if isPrimaryAdmin()
        || (
          isClinicMember(clinicId)
          && request.resource.data.ownerEmail == resource.data.ownerEmail
          && request.resource.data.accessEmails == resource.data.accessEmails
          && request.resource.data.authorizedUids == resource.data.authorizedUids
          && request.resource.data.planTier == resource.data.planTier
          && request.resource.data.subscriptionStatus == resource.data.subscriptionStatus
          && request.resource.data.patientLimit == resource.data.patientLimit
          && request.resource.data.storageLimitMb == resource.data.storageLimitMb
          && request.resource.data.monthlyFeeAmount == resource.data.monthlyFeeAmount
          && request.resource.data.billingCycle == resource.data.billingCycle
        );

      match /patients/{patientId} {
        allow list: if isPrimaryAdmin()
          || (isSignedIn() && request.auth.uid in resource.data.clinicAccessUids);
        allow get, create, update, delete: if isClinicWritable(clinicId);

        match /consultations/{consultationId} {
          allow list: if isPrimaryAdmin()
            || (isSignedIn() && request.auth.uid in resource.data.clinicAccessUids);
          allow get, create, update, delete: if isClinicWritable(clinicId);
        }

        match /photos/{photoId} {
          allow list: if isPrimaryAdmin()
            || (isSignedIn() && request.auth.uid in resource.data.clinicAccessUids);
          allow get, create, update, delete: if isClinicWritable(clinicId);
        }

        match /clinical_notes/{noteId} {
          allow list: if isPrimaryAdmin()
            || (isSignedIn() && request.auth.uid in resource.data.clinicAccessUids);
          allow get, create, update, delete: if isClinicWritable(clinicId);
        }
      }

      match /fee_records/{feeId} {
        allow list: if isPrimaryAdmin()
          || (isSignedIn() && request.auth.uid in resource.data.clinicAccessUids);
        allow get, create, update, delete: if isClinicWritable(clinicId);
      }

      match /repertory_entries/{entryId} {
        allow list: if isPrimaryAdmin()
          || (isSignedIn() && request.auth.uid in resource.data.clinicAccessUids);
        allow get, create, update, delete: if isClinicWritable(clinicId);
      }

      match /disease_remedies/{entryId} {
        allow list: if isPrimaryAdmin()
          || (isSignedIn() && request.auth.uid in resource.data.clinicAccessUids);
        allow get, create, update, delete: if isClinicWritable(clinicId);
      }
    }

    // 4. Legacy Root Collections (Strictly Super Admin Only)
    match /patients/{patientId} {
      allow read, write: if isPrimaryAdmin();

      match /consultations/{consultationId} {
        allow read, write: if isPrimaryAdmin();
      }
      match /photos/{photoId} {
        allow read, write: if isPrimaryAdmin();
      }
      match /clinical_notes/{noteId} {
        allow read, write: if isPrimaryAdmin();
      }
    }

    match /clinic_settings/{settingId} {
      allow read, write: if isPrimaryAdmin();
    }

    match /admins/{adminId} {
      allow read, write: if isPrimaryAdmin();
    }

    match /repertory_entries/{entryId} {
      allow read, write: if isPrimaryAdmin();
    }

    match /fee_records/{feeId} {
      allow read, write: if isPrimaryAdmin();
    }
  }
}
