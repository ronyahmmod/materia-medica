# GEMINI_API_KEY: Required for clinical repertory search and constitutional analysis.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where the clinic SaaS application is hosted.
APP_URL="MY_APP_URL"

# ADMIN_EMAILS: Comma-separated verified Google emails permitted for Super Admin access.
ADMIN_EMAILS="rony.jib@gmail.com"

# UPLOAD_STORAGE_DIR: Local directory path for clinical photo storage.
UPLOAD_STORAGE_DIR="./data/uploads"

# VITE_API_BASE_URL: Optional external Node backend URL when hosting dist/ statically on Firebase Hosting Spark.
VITE_API_BASE_URL=""

# CORS_ALLOW_ORIGINS: Optional comma-separated origins allowed to call /api/* (Firebase Hosting domains are allowed automatically).
CORS_ALLOW_ORIGINS=""

# Backblaze B2 Private Media Storage (10 GB Free, server-side only — never prefix with VITE_)
B2_KEY_ID=""
B2_APPLICATION_KEY=""
B2_BUCKET_NAME=""
B2_BUCKET_ID=""
B2_KEY_PREFIX="clinic-photos"


