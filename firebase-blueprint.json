{
  "entities": {
    "ClinicTenant": {
      "title": "ClinicTenant",
      "description": "Multi-tenant SaaS homeopathic clinic profile, branding customization, hosting config, and subscription quotas managed by the Super Admin.",
      "type": "object",
      "properties": {
        "slug": {
          "type": "string",
          "description": "Unique URL-safe clinic identifier used in shareable client URLs",
          "minLength": 2,
          "maxLength": 64,
          "pattern": "^[a-z0-9-]+$"
        },
        "clinicName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "practitionerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "ownerEmail": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 160
        },
        "accessEmails": {
          "type": "array",
          "description": "Bounded list of lowercase emails assigned to this clinic (1 to 10)"
        },
        "authorizedUids": {
          "type": "array",
          "description": "Bounded list of Firebase Auth UIDs assigned by Super Admin for password sign-in (1 to 10)"
        },
        "tagline": {
          "type": "string",
          "maxLength": 240
        },
        "phone": {
          "type": "string",
          "maxLength": 40
        },
        "address": {
          "type": "string",
          "maxLength": 300
        },
        "currencySymbol": {
          "type": "string",
          "enum": ["৳", "$", "₹", "€", "£"]
        },
        "accentColor": {
          "type": "string",
          "enum": ["teal", "indigo", "emerald", "slate"]
        },
        "planTier": {
          "type": "string",
          "enum": ["free", "growth", "clinic_pro"]
        },
        "subscriptionStatus": {
          "type": "string",
          "enum": ["active", "trial", "suspended"]
        },
        "patientLimit": {
          "type": "number"
        },
        "storageLimitMb": {
          "type": "number"
        },
        "hostingProvider": {
          "type": "string",
          "maxLength": 120
        },
        "monthlyFeeAmount": {
          "type": "number"
        },
        "billingCycle": {
          "type": "string",
          "enum": ["free", "monthly", "yearly"]
        },
        "subscriptionNotes": {
          "type": "string",
          "maxLength": 500
        },
        "createdBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "slug",
        "clinicName",
        "practitionerName",
        "ownerEmail",
        "accessEmails",
        "authorizedUids",
        "currencySymbol",
        "accentColor",
        "planTier",
        "subscriptionStatus",
        "patientLimit",
        "storageLimitMb",
        "monthlyFeeAmount",
        "billingCycle",
        "createdBy",
        "createdAt",
        "updatedAt"
      ]
    },
