      "properties": {
        "clinicId": {
          "type": "string",
          "maxLength": 128
        },
        "clinicAccessEmails": {
          "type": "array"
        },
        "clinicAccessUids": {
          "type": "array"
        },
        "patientId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "patientName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "caseNumber": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "consultationId": {
          "type": "string",
          "maxLength": 128
        },
        "collectedDate": {
          "type": "string",
          "minLength": 4,
          "maxLength": 32
        },
        "feeType": {
          "type": "string",
          "enum": ["consultation", "medicine", "follow-up", "due-settlement", "other"]
        },
        "feeAmount": {
          "type": "number",
          "description": "Gross fee charged before discount"
        },
        "discountAmount": {
          "type": "number",
          "description": "Discount deducted from gross fee"
        },
        "netAmount": {
          "type": "number",
          "description": "Net payable amount (feeAmount - discountAmount)"
        },
        "cashPaid": {
          "type": "number",
          "description": "Cash amount collected from the patient"
        },
        "dueAmount": {
          "type": "number",
          "description": "Remaining balance due (netAmount - cashPaid)"
        },
        "notes": {
          "type": "string",
          "maxLength": 500
        },
        "isDeleted": {
          "type": "boolean"
        },
        "deletedAt": {
          "type": "string",
          "maxLength": 40
        },
        "deletedBy": {
          "type": "string",
          "maxLength": 128
        },
        "restoredAt": {
          "type": "string",
          "maxLength": 40
        },
        "createdBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "patientId",
        "patientName",
        "caseNumber",
        "collectedDate",
        "feeType",
        "feeAmount",
        "discountAmount",
        "netAmount",
        "cashPaid",
        "dueAmount",
        "createdBy",
        "createdAt",
        "updatedAt"
      ]
    }
  },
