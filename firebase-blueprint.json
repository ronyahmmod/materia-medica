          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fullName": {
          "type": "string",
          "description": "Patient full name or animal name/tag",
          "minLength": 1,
          "maxLength": 120
        },
        "age": {
          "type": "number",
          "description": "Patient age in years"
        },
        "gender": {
          "type": "string",
          "enum": ["Female", "Male", "Other"]
        },
        "phone": {
          "type": "string",
          "description": "Primary contact phone number",
          "minLength": 3,
          "maxLength": 32
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 160
        },
        "address": {
          "type": "string",
          "maxLength": 300
        },
        "chiefComplaint": {
          "type": "string",
          "description": "Primary presenting homeopathic complaint",
          "minLength": 1,
          "maxLength": 500
        },
        "thermalState": {
          "type": "string",
          "enum": ["Chilly", "Hot", "Ambithermal", "Unspecified"]
        },
        "constitutionNotes": {
          "type": "string",
          "maxLength": 2000
        },
        "allergies": {
          "type": "string",
          "maxLength": 500
        },
        "portraitUrl": {
          "type": "string",
          "maxLength": 300
        },
        "portraitPhotoId": {
          "type": "string",
          "maxLength": 128
        },
        "status": {
          "type": "string",
          "enum": ["active", "follow-up", "archived"]
        },
        "lastVisitDate": {
          "type": "string",
          "maxLength": 32
        },
        "nextFollowUpDate": {
          "type": "string",
          "maxLength": 32
        },
        "lastRemedy": {
          "type": "string",
          "maxLength": 160
        },
        "isDeleted": {
          "type": "boolean"
        },
        "deletedAt": {
          "type": "string",
          "maxLength": 40
        },
        "deletedBy": {
          "type": "string",
          "maxLength": 128
        },
        "restoredAt": {
          "type": "string",
          "maxLength": 40
        },
        "createdBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
