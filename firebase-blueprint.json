    "Patient": {
      "title": "Patient",
      "description": "Homeopathic patient clinical record isolated by clinicId.",
      "type": "object",
      "properties": {
        "clinicId": {
          "type": "string",
          "maxLength": 128
        },
        "clinicAccessEmails": {
          "type": "array",
          "description": "Authorized clinic admin emails mirrored from parent clinic"
        },
